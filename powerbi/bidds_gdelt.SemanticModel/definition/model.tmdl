model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["weekly","locations","urls","url_check","RepoFolder"]

annotation PBI_ProTooling = ["DevMode"]

ref table weekly
ref table locations
ref table urls
ref table url_check

